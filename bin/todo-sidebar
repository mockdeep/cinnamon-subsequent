#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Cinnamon todo sidebar.

# Locate our Gemfile regardless of the working directory, so the app can be
# launched from anywhere (e.g. an autostart .desktop entry).
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "config"
require "pid_file"
require "app"
require "sessions/watcher"
require "sessions/focus"

# Record this instance so `rake sidebar:*` can find it; clear on a clean exit
# (window close). A SIGTERM/kill leaves the file behind, but PidFile.running_pid
# treats a dead/reused pid as "not running" and clears it, so it self-heals.
PidFile.write
at_exit { PidFile.clear }

POLL_INTERVAL_MS = 1000

app = App.new(Config.load)
app.start
app.on_session_focus { |session_id| Sessions::Focus.call(session_id) }

watcher = Sessions::Watcher.new
watcher.on_change do |sessions, focused_xid|
  app.update_sessions(sessions, focused_xid)
end

# The app's one polling loop; the Trello side stays manual-refresh. It drives
# two unrelated checks, each guarded so a failure in one can't stop the other:
#
#   watcher.tick     mirrors Claude Code's session state into the footer dots
#   app.check_layout re-fits the window when the desktop workarea moves
#
# The layout check is a poll rather than a signal because GDK never announces a
# workarea change. Verified on Cinnamon: resizing the panel moves the workarea
# and updates GdkMonitor's own value, but notify::workarea, monitors-changed and
# size-changed all stay silent. Both checks are cheap no-ops when nothing moved.
poll =
  lambda do
    watcher.tick # rescues internally
    begin
      app.check_layout
    rescue StandardError => e
      warn("Layout check failed: #{e.message}")
    end
  end

poll.call
GLib::Timeout.add(POLL_INTERVAL_MS) do
  poll.call
  true
end

Gtk.main
